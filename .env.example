# Local only. This file is ignored by Git. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_CODE_MODEL=gpt-6-sol
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Claude handles planning/code; artwork always uses OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_CODE_MODEL=claude-sonnet-5-5
# Required only for multi-workspace keys (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Local development may use the server key. Public installations require each visitor's own key.
ALLOW_SERVER_KEY=false
